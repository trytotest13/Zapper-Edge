# =====================================================
# Zapper Edge — .gitignore
# =====================================================

# OS junk
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db

# Windows
$RECYCLE.BIN/
*.lnk

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Node (if you ever add tooling)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python (if you ever add tooling)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build artifacts
dist/
build/
*.min.js
*.min.css

# Temp / scratch
*.tmp
*.bak
*.orig
*.swp
.tmp/
.cache/
